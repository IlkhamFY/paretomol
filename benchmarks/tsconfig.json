{
  "compilerOptions": {
    "composite": true,
    "outDir": "../node_modules/.tmp/benchmarks",
    "rootDir": ".",
    "declaration": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"],
    "tsBuildInfoFile": "../node_modules/.tmp/benchmarks.tsbuildinfo"
  },
  "include": ["agents/**/*.ts"],
  "references": [
    { "path": "../packages/core" },
    { "path": "../packages/mcp" }
  ]
}

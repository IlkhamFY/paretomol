{
  "name": "@paretomol/mcp",
  "version": "0.1.0",
  "description": "ParetoMol MCP server (stdio): score molecules, Pareto fronts, scoring profiles, trade-off readings, review links and claim checks for chemistry agents.",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.IlkhamFY/paretomol",
  "bin": {
    "paretomol-mcp": "./bin/paretomol-mcp.js"
  },
  "main": "./dist/src/server.js",
  "types": "./dist/src/server.d.ts",
  "exports": {
    ".": {
      "source": "./src/server.ts",
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./tools": {
      "source": "./src/tools.ts",
      "types": "./dist/src/tools.d.ts",
      "default": "./dist/src/tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "server.json",
    "ui/review.html"
  ],
  "scripts": {
    "build": "node scripts/build-ui.mjs && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paretomol/core": "0.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlkhamFY/paretomol.git",
    "directory": "packages/mcp"
  },
  "engines": {
    "node": ">=20.10"
  }
}

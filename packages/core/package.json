{
  "name": "@paretomol/core",
  "version": "0.1.0",
  "description": "Framework-free ParetoMol core: Pareto ranking, objectives, MPO, QED, filters and versioned scoring profiles.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verify": {
      "source": "./src/verify.ts",
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./profiles/*.json": "./dist/profiles/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@rdkit/rdkit": "2025.3.4-1.0.0",
    "fflate": "^0.8.2",
    "lz-string": "^1.5.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlkhamFY/paretomol.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20.10"
  }
}
